{
  "name": "pixel-agents-web",
  "displayName": "Pixel Agents Web",
  "description": "Pixel art office where your Claude Code agents come to life — web version",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:server": "tsc -p server/tsconfig.json",
    "build:webview": "cd webview-ui && npm run build",
    "build:assets": "node scripts/copy-assets.js",
    "build": "npm run build:server && npm run build:webview && npm run build:assets",
    "start": "node dist/server/server.js",
    "dev": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "22.x",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.3"
  }
}
